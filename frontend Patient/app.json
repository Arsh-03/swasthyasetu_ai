{
  "expo": {
    "name": "SwasthyaSetu",
    "slug": "swasthyasetu-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swasthyasetu.patient"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.swasthyasetu.patient"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "SwasthyaSetu uses your camera so your doctor can see you during a video consultation.",
          "microphonePermission": "SwasthyaSetu uses your microphone so your doctor can hear you during a video consultation."
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ]
  }
}
