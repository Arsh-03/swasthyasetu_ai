# ==========================================
# CareBridge India (SwasthyaSetu AI) Config
# ==========================================

# Secret key used for cryptographic HMAC token signing and JWT sessions
# Generate a secure key in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Token Time-to-Live in seconds (Default: 3600 = 60 minutes)
DEFAULT_TOKEN_TTL_SECONDS=3600

# SQLite Async Database URL
DATABASE_URL=sqlite+aiosqlite:///./carebridge.db

# Debug Mode
DEBUG=True

# ------------------------------------------
# AI IntelliSense Tier 3: self-hosted language-model autocomplete.
# Sovereign by design: the model runs on a server you control; no third-party AI API is used.
#   (empty) -> off
#   stub    -> canned suggestions, no model or GPU needed (development)
#   local   -> your own Ollama server running an open model, e.g. Med-Gemma
# Deployment guide: docs/07_ai_intellisense_feature/07_tier3_sovereign_deployment.md
# ------------------------------------------
INTELLISENSE_LLM_PROVIDER=
INTELLISENSE_LLM_TIMEOUT_S=6
INTELLISENSE_LLM_MAX_CONCURRENCY=1
INTELLISENSE_STUB_DELAY_MS=300
INTELLISENSE_LOCAL_URL=http://127.0.0.1:11434
INTELLISENSE_LOCAL_MODEL=
INTELLISENSE_LOCAL_KEEP_ALIVE=30m
INTELLISENSE_LOCAL_NUM_CTX=2048
INTELLISENSE_LOCAL_NUM_THREAD=0
INTELLISENSE_HEALTH_INTERVAL_S=30

# ------------------------------------------
# Consultation call minutes (docs/09_call_minutes)
# SCRIBE_ASR_PROVIDER: stub (demo script) | http (your Whisper-style server) | empty (off)
# ------------------------------------------
SCRIBE_ASR_PROVIDER=stub
SCRIBE_ASR_URL=
SCRIBE_ASR_MODEL=whisper-large-v3
SCRIBE_ASR_LANGUAGE=
SCRIBE_ASR_TRANSLATE=true
SCRIBE_ASR_TIMEOUT_S=60
SCRIBE_LLM_PROVIDER=
SCRIBE_LLM_MODEL=

# ------------------------------------------
# Remote GPU gateway (e.g. Google Colab + ngrok, docs/10_remote_gpu_colab)
# Shared secret; must match GATEWAY_TOKEN in the notebook. Leave empty for a local server.
# ------------------------------------------
AI_GATEWAY_TOKEN=
# SETU-Shield: who runs the AI servers. self_hosted (ours) or third_party. Voice is never sent to a third party.
AI_TEXT_DESTINATION=self_hosted
AI_SPEECH_DESTINATION=self_hosted

# Text AI for every feature (autocomplete, CHIBI agent, summaries). Leave AI_PROVIDER empty to use your Ollama
# server above; or use Gemini / OpenAI (they are treated as third parties: masked text only, never voice).
#   AI_PROVIDER=gemini   AI_API_KEY=<your Gemini key>   (AI_MODEL optional, e.g. gemini-2.5-flash)
#   AI_PROVIDER=openai   AI_API_KEY=<your OpenAI key>   (AI_MODEL optional, e.g. gpt-4o-mini)
#   AI_PROVIDER=openai_compatible  AI_API_BASE=https://api.groq.com/openai/v1  AI_API_KEY=...  AI_MODEL=...
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Requests per minute (0 = provider default: Gemini free tier 10, OpenAI 60)
AI_MAX_RPM=0
