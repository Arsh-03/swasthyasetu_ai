              "raw": "{\n  \"notification\": {\n    \"patient\": {\n      \"id\": \"<ABHA_ADDRESS>\"\n    },\n    \"careContext\": {\n      \"patientReference\": \"<ABHA_ADDRESS>\",\n      \"careContextReference\": \"b009a970-8b04-4779-abd1-b50f113245bf\"\n    },\n    \"hiTypes\": [\n      \"DiagnosticReport\"\n    ],\n    \"date\": \"2024-05-09T10:34:00.387Z\",\n    \"hip\": {\n      \"id\": \"ABDM_HIP\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
